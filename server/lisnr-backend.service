[Unit]
Description=LISNR Audio Backend Service (Node.js + WebSockets + ffmpeg)
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/lisnr/server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
EnvironmentFile=/home/azureuser/lisnr/server/.env

[Install]
WantedBy=multi-user.target
